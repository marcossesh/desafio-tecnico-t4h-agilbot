# --- LLM -------------------------------------------------------------------
# Uma chave já é suficiente para rodar. Com as duas, o Groq atua como fallback
# automático do Gemini quando a cota do free tier estoura.
GOOGLE_API_KEY=
GROQ_API_KEY=

# A linha flash-lite é a de maior cota diária no free tier. Versão fixada de propósito:
# `gemini-flash-lite-latest` é alias móvel e mudaria o comportamento sem alterar o código.
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile

# Vazio = não enviar. Os modelos Gemini 3.x usam amostragem fixa e ignoram o parâmetro.
LLM_TEMPERATURE=

# --- Sessões e RAG ---------------------------------------------------------
# Mesmo Postgres atende os checkpoints do LangGraph e os vetores do pgvector.
# Vazio -> sessões em memória (MemorySaver) e RAG desabilitado. A aplicação
# sobe normalmente nos dois casos.
POSTGRES_URL=postgresql://agilbot:agilbot@localhost:5432/agilbot

# O RAG também exige GOOGLE_API_KEY (embeddings). Sem ela, fica desligado.
EMBEDDING_MODEL=models/gemini-embedding-001
RAG_TOP_K=3

# --- Câmbio ----------------------------------------------------------------
# AwesomeAPI não exige chave.
AWESOMEAPI_BASE_URL=https://economia.awesomeapi.com.br/json/last
